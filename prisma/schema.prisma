generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* ============================================================
   USERS / VENDORS / BUYERS
   ============================================================ */

model Vendor {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  emailVerifiedAt DateTime?
  password        String
  status          String          @default("pending")
  companyName     String?
  siret           String?
  vatNumber       String?
  vatValid        Boolean         @default(false)
  legalForm       String?
  address         String?
  iban            String?
  incoterms       String?
  onboardingStep  Int             @default(1)
  createdAt       DateTime        @default(now())
  activatedAt     DateTime?
  // ID du compte Stripe Connect du vendeur (acct_xxx).
  // Quand renseigné + chargesEnabled=true, les paiements peuvent être
  // routés directement vers le vendeur via destination charges.
  stripeAccountId      String?    @unique
  stripeChargesEnabled Boolean    @default(false)
  documents       Document[]
  certifications  Certification[]
  catalogs        Catalog[]
  notifications   Notification[]
  quotes          Quote[]
}

model Buyer {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  emailVerifiedAt DateTime?
  password      String
  phone         String?
  address       String?
  createdAt     DateTime       @default(now())
  orders        Order[]
  notifications Notification[]
  favorites     Favorite[]
  reviews       Review[]
  quotes        Quote[]
}

/* ============================================================
   ONBOARDING DOCS / CERTIFICATIONS
   ============================================================ */

model Document {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  type       String
  filename   String
  s3Key      String
  status     String   @default("pending")
  uploadedAt DateTime @default(now())
}

model Certification {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  certType   String
  filename   String
  s3Key      String
  category   String
  uploadedAt DateTime @default(now())
}

/* ============================================================
   CATALOG / PRODUCTS / PHOTOS
   ============================================================ */

model Catalog {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String?
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id          String      @id @default(cuid())
  catalogId   String
  catalog     Catalog     @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  name        String
  reference   String?
  description String?
  price       Float
  weightKg    Float?
  dimensions  String?
  category    String?
  stock       Int         @default(0)
  active      Boolean     @default(true)
  // Traductions de la description, generees par Claude.
  // Format : { "en": "...", "de": "...", "es": "..." }
  // La langue source est toujours le francais (champ `description`).
  // Stockee en JSON pour rester flexible (ajout de langues sans migration).
  translations Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  photos      Photo[]
  orderLines  OrderLine[]
  favorites   Favorite[]
  reviews     Review[]
  quotes      Quote[]

  @@index([catalogId])
  @@index([category])
}

model Photo {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  primary   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

/* ============================================================
   ORDERS
   ============================================================ */

model Order {
  id        String      @id @default(cuid())
  buyerId   String
  buyer     Buyer       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  status    String      @default("EN_COURS") // EN_COURS | LIVREE | ANNULEE
  totalCents Int        @default(0)
  // Identifiant Stripe Checkout — sert à l'idempotence du webhook
  // ET à retrouver la commande depuis la page /checkout/success.
  stripeSessionId String? @unique
  orderedAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  lines     OrderLine[]
  messages  Message[]

  @@index([buyerId])
  @@index([status])
}

/* ============================================================
   MESSAGERIE COMMANDES (chat buyer/vendor par commande)
   ============================================================ */

/* ============================================================
   WEB PUSH SUBSCRIPTIONS
   ============================================================ */

/* ============================================================
   TOKENS (verification email + reset password)
   ============================================================ */

model AuthToken {
  id        String   @id @default(cuid())
  // Type de token : "VERIFY_EMAIL" (confirme l'inscription) ou
  // "RESET_PASSWORD" (autorise un changement de mot de passe).
  type      String
  // Audience : "BUYER" ou "VENDOR" (l'admin n'a pas de compte BDD).
  userType  String
  userId    String
  // Token aléatoire opaque (32 bytes hex). Stocké en clair pour la
  // simplicité du flow ; pour passer en prod stricte, stocker le hash.
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userType, userId, type])
  @@index([expiresAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  // Souscription liée à un Vendor OU un Buyer (jamais les deux).
  // Pas de relation forte pour simplifier (les souscriptions peuvent
  // survivre à un changement de compte, et on n'a pas besoin d'une
  // contrainte ON DELETE CASCADE ici).
  vendorId  String?
  buyerId   String?
  // PushSubscription JSON serialisée (endpoint, keys.p256dh, keys.auth).
  // On stocke l'endpoint en clé unique pour éviter les doublons quand
  // un même browser ré-souscrit.
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  // utile pour debug "quel device a souscrit"
  createdAt DateTime @default(now())

  @@index([vendorId])
  @@index([buyerId])
}

model Message {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Auteur : exactement un des deux (buyer OU vendor). On ne fait pas
  // de relation Prisma forte vers Buyer/Vendor pour rester flexible
  // (un message reste valide même si le compte est supprimé — le contenu
  // est conservé pour traçabilité de la conversation).
  authorType String   // "BUYER" | "VENDOR"
  authorId   String
  authorName String   // snapshot du nom au moment de l'envoi (audit)
  content    String   // max 5000 chars, validé côté API
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([orderId, authorType])
}

model OrderLine {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  quantity      Int      @default(1)
  unitPriceCents Int
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

/* ============================================================
   NOTIFICATIONS
   ============================================================ */

/* ============================================================
   FAVORITES (wishlist) / REVIEWS
   ============================================================ */

model Favorite {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Un acheteur ne peut favoriter un produit qu'une seule fois.
  @@unique([buyerId, productId])
  @@index([buyerId])
  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Note de 1 à 5. La validation est faite côté serveur dans l'API.
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un acheteur écrit au plus un avis par produit (il peut le modifier).
  @@unique([buyerId, productId])
  @@index([productId])
}

/* ============================================================
   DEVIS B2B
   ============================================================ */

model Quote {
  id          String   @id @default(cuid())

  // Produit concerné
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Vendeur destinataire (déduit depuis le produit, stocké pour requêtes rapides)
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Acheteur — peut être un compte Buyer enregistré OU un visiteur anonyme.
  // Dans les deux cas on conserve l'email pour les notifications.
  buyerId     String?
  buyer       Buyer?   @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerEmail  String
  buyerName   String
  buyerPhone  String?
  buyerCompany String?

  // Demande de l'acheteur
  quantity    Int      @default(1)
  message     String?  // contexte, délai souhaité, conditions particulières

  // Réponse du vendeur
  // PENDING → vendeur n'a pas encore répondu
  // RESPONDED → vendeur a répondu (priceCents + vendorMessage renseignés)
  // ACCEPTED → acheteur a accepté le devis
  // REJECTED → vendeur a refusé OU acheteur a décliné
  // EXPIRED → validUntil dépassé sans réponse de l'acheteur
  status       String  @default("PENDING")
  vendorPriceCents  Int?    // prix unitaire négocié en centimes
  vendorMessage     String? // message/conditions du vendeur
  validUntil        DateTime? // date limite d'acceptation du devis
  pdfUrl            String?   // URL Supabase Storage du PDF généré

  // Token unique envoyé à l'acheteur pour accéder à son devis sans compte
  accessToken String?  @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vendorId, status])
  @@index([buyerEmail])
  @@index([productId])
  @@index([accessToken])
}

model Notification {
  id        String   @id @default(cuid())
  // Une notification est rattachée à un Vendor OU un Buyer (jamais les deux)
  vendorId  String?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  buyerId   String?
  buyer     Buyer?   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  content   String
  readAt    DateTime?
  sentAt    DateTime @default(now())

  @@index([vendorId])
  @@index([buyerId])
  @@index([sentAt])
}
